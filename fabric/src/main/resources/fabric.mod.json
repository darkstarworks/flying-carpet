{
  "schemaVersion": 1,
  "id": "flyingcarpet",
  "version": "${version}",
  "name": "Flying Carpet",
  "description": "A rideable, enchanted Flying Carpet made from three matching Cushions. Flies faster than a Happy Ghast, with an on-screen flight panel and a settings screen for speed, getting off, breaking and the recipe.",
  "authors": [
    "darkstarworks"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/flying-carpet",
    "issues": "https://modrinth.com/mod/flying-carpet"
  },
  "license": "ARR",
  "icon": "assets/flyingcarpet/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.darkstarworks.flyingcarpet.FlyingCarpetFabric"
    ],
    "client": [
      "com.darkstarworks.flyingcarpet.client.FlyingCarpetClient"
    ],
    "modmenu": [
      "com.darkstarworks.flyingcarpet.client.ModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "com.darkstarworks.flyingcarpet.compat.jei.FlyingCarpetJeiPlugin"
    ]
  },
  "mixins": [
    "flyingcarpet.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3-",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "jei": "*"
  }
}
